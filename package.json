{
  "name": "menuyukti-repo",
  "private": true,
  "description": "Menuyukti MCP monorepo (Skybridge app + Codex plugin)",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "scripts": "node -e \"const p=require('./package.json'); console.log('Scripts:'); for (const [k,v] of Object.entries(p.scripts)) { if (k==='scripts') continue; console.log('  pnpm ' + k.padEnd(22) + v); }\"",
    "mcp": "bash scripts/run-mcp-skybridge.sh",
    "mcp:skybridge": "pnpm mcp",
    "mcp:prod": "bash scripts/run-mcp-skybridge-prod.sh",
    "mcp:tunnel": "bash scripts/run-mcp-skybridge-tunnel.sh",
    "mcp:inspect": "bash scripts/mcp-inspect.sh",
    "widgets:preview": "pnpm --filter menuyukti widgets:preview",
    "check": "bash scripts/check.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm --filter menuyukti typecheck",
    "test": "pnpm --filter menuyukti test",
    "check:skills": "bash scripts/check-plugin-skills-sync.sh",
    "sync:plugin-skills": "bash scripts/sync-plugin-skills.sh",
    "sync:codex-plugin": "bash scripts/sync-codex-plugin.sh",
    "backlog": "backlog browser --port 6421 --no-open"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8"
  }
}
